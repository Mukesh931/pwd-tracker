# Alternative to nginx+certbot: Caddy gives automatic HTTPS in 2 lines.
# Install:  sudo apt install -y debian-keyring debian-archive-keyring apt-transport-https &&
#           curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | sudo gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg &&
#           curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | sudo tee /etc/apt/sources.list.d/caddy-stable.list &&
#           sudo apt update && sudo apt install caddy
# Then replace this file's domain and:  sudo caddy run --config /opt/pwd-tracker/deploy/Caddyfile
# (or `sudo systemctl enable --now caddy` with this file at /etc/caddy/Caddyfile)

yourdomain.com {
    reverse_proxy localhost:3000
}
